{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hivingstudio.fr"
        }
      ],
      "destination": "https://hivingstudio.fr/:path*",
      "permanent": true
    },
    {
      "source": "/pages/le-blanc.html",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/le-blanc",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/la-table.html",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/la-table",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/la-cuisine.html",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/la-cuisine",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/plan-3d.html",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/plan-3d",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/comparateur.html",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/comparateur",
      "destination": "/#plateaux",
      "permanent": true
    },
    {
      "source": "/pages/equipe.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/equipe",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/presse.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/presse",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/travaux.html",
      "destination": "/pages/services.html",
      "permanent": true
    },
    {
      "source": "/pages/travaux",
      "destination": "/pages/services.html",
      "permanent": true
    },
    {
      "source": "/pages/case-picard.html",
      "destination": "/pages/services.html",
      "permanent": true
    },
    {
      "source": "/pages/case-picard",
      "destination": "/pages/services.html",
      "permanent": true
    },
    {
      "source": "/:file(.*\\.(?:mp4|glb))",
      "destination": "https://xy8wkkceax6fodpg.public.blob.vercel-storage.com/hivingstudio-fr/:file",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/((?!admin\\.html).*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://pmrqrbjxikljlarhkseu.supabase.co; media-src 'self' blob: https://xy8wkkceax6fodpg.public.blob.vercel-storage.com; connect-src 'self' https://pmrqrbjxikljlarhkseu.supabase.co wss://pmrqrbjxikljlarhkseu.supabase.co; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://pmrqrbjxikljlarhkseu.supabase.co; media-src 'self' blob: https://xy8wkkceax6fodpg.public.blob.vercel-storage.com; connect-src 'self' https://pmrqrbjxikljlarhkseu.supabase.co wss://pmrqrbjxikljlarhkseu.supabase.co; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/((?!js/).*)\\.(css|js|jsx|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
